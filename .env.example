# Plinth Build Environment Configuration
# Copy this to .env and customize for your environment

# Signing Configuration
SIGNING_IDENTITY=Developer ID Application: Example Organisation (TEAMID0000)
INSTALLER_IDENTITY=Developer ID Installer: Example Organisation (TEAMID0000)
KEYCHAIN=${HOME}/Library/Keychains/signing.keychain

# Notarization Configuration
NOTARIZATION_PROFILE=notarization_credentials

# Optional: Override build settings
# VERSION=1.0.0
# BUILD_NUMBER=1
